---
import type { Props } from '@astrojs/starlight/props';
import Default from '@astrojs/starlight/components/Footer.astro';
---

<Default {...Astro.props}><slot /></Default>

<!-- Giscus 댓글 -->
<div class="giscus-container">
  <script is:inline
    src="https://giscus.app/client.js"
    data-repo="noisonnoiton/noisonnoiton.github.io"
    data-repo-id="R_kgDOGjaniQ"
    data-category="Announcements"
    data-category-id="DIC_kwDOGjanic4C4fBW"
    data-mapping="pathname"
    data-strict="0"
    data-reactions-enabled="1"
    data-emit-metadata="0"
    data-input-position="top"
    data-theme="preferred_color_scheme"
    data-lang="ko"
    data-loading="lazy"
    crossorigin="anonymous"
    async>
  </script>
</div>

<!-- 카카오 애드핏 -->
<div class="kakao-ad-footer">
  <!-- PC: 728x90 -->
  <div class="ad-pc">
    <ins class="kakao_ad_area" style="display:none;"
      data-ad-unit="DAN-zPDP0gYVaGwOEH3v"
      data-ad-width="728"
      data-ad-height="90">
    </ins>
  </div>
  <!-- Mobile: 250x250 -->
  <div class="ad-mobile">
    <ins class="kakao_ad_area" style="display:none;"
      data-ad-unit="DAN-zHXbzhtivpd6MTA0"
      data-ad-width="250"
      data-ad-height="250">
    </ins>
  </div>
</div>

<script is:inline src="//t1.daumcdn.net/kas/static/ba.min.js" async></script>

<style>
  .giscus-container {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--sl-color-gray-5);
  }
  .kakao-ad-footer {
    display: flex;
    justify-content: center;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--sl-color-gray-5);
  }
  .ad-pc { display: block; }
  .ad-mobile { display: none; }

  @media (max-width: 768px) {
    .ad-pc { display: none; }
    .ad-mobile { display: block; }
  }
</style>
